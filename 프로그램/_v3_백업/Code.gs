r(--surface2);color:var(--ink2);border-radius:6px;padding:1px 8px;font-size:.8rem;font-weight:700}\n.banner{background:var(--soon-bg);color:var(--ink);border-radius:var(--r);padding:14px 18px;display:flex;flex-wrap:wrap;gap:10px;align-items:center}\n.empty{text-align:center;padding:36px 16px;color:var(--ink2);display:flex;flex-direction:column;gap:14px;align-items:center}\n\n/* 차량 고르기 */\n.chips{display:flex;flex-wrap:wrap;gap:8px}\n.chip{min-height:46px;padding:8px 16px;border-radius:999px;border:2px solid var(--line);background:var(--surface);cursor:pointer;font-weight:500}\n.chip[aria-pressed=\"true\"]{background:var(--navy);border-color:var(--navy);color:var(--navy-ink);font-weight:700}\n\n/* 오늘 화면 */\n.hero{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:18px;align-items:center}\n@media (max-width:700px){.hero{grid-template-columns:minmax(0,1fr)}}\n.odo{display:flex;gap:4px;flex-wrap:nowrap;align-items:flex-end}\n.odo span{font-family:var(--f-display);font-size:clamp(1.7rem,7vw,2.5rem);line-height:1;background:var(--ink);color:var(--surface);border-radius:6px;padding:8px clamp(5px,1.6vw,9px) 6px;font-variant-numeric:tabular-nums}\n.odo em{font-style:normal;font-weight:700;color:var(--ink2);padding-left:6px}\n.sumrow{display:flex;flex-wrap:wrap;gap:8px}\n.alerts{display:flex;flex-direction:column;gap:10px}\n.alert{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:8px 14px;align-items:center;padding:14px 16px;border-radius:var(--r);background:var(--surface);border:1px solid var(--line)}\n.alert .mark{width:14px;align-self:stretch;border-radius:7px}\n.alert.over .mark{background:var(--over)} .alert.soon .mark{background:var(--soon)} .alert.unk .mark{background:var(--unk)} .alert.ok .mark{background:var(--ok)}\n.alert .why{color:var(--ink2);font-size:.93rem}\n@media (max-width:560px){.alert{grid-template-columns:auto minmax(0,1fr)} .alert .act{grid-column:2}}\n.bar{height:10px;border-radius:5px;background:var(--surface2);overflow:hidden;margin-top:6px}\n.bar i{display:block;height:100%;border-radius:5px;background:var(--ok)}\n.bar.soon i{background:var(--soon)} .bar.over i{background:var(--over)}\n\n/* 표 */\n.tablebox{overflow-x:auto;border:1px solid var(--line);border-radius:var(--r);background:var(--surface)}\ntable{border-collapse:collapse;width:100%;font-size:.97rem}\nth,td{padding:10px 12px;text-align:left;border-bottom:1px solid var(--line);white-space:nowrap}\nth{background:var(--surface2);font-size:.9rem}\ntd.r,th.r{text-align:right;font-variant-numeric:tabular-nums}\ntr:last-child td{border-bottom:0}\ntfoot td{font-weight:700;background:var(--surface2)}\n.linkbtn{border:0;background:none;color:var(--navy);font-weight:700;cursor:pointer;padding:6px 4px;text-decoration:underline}\n\n/* 입력 창 */\ndialog{border:0;border-radius:18px;padding:0;background:var(--surface);color:var(--ink);width:min(640px,calc(100vw - 24px));max-height:calc(100dvh - 24px)}\ndialog::backdrop{background:rgba(10,16,28,.55)}\n.dlg{display:flex;flex-direction:column;max-height:calc(100dvh - 24px)}\n.dlg header{padding:16px 20px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:10px}\n.dlg header h2{flex:1}\n.dlg .body{padding:18px 20px;overflow-y:auto;display:flex;flex-direction:column;gap:18px}\n.dlg footer{padding:14px 20px;border-top:1px solid var(--line);display:flex;gap:10px;justify-content:flex-end;flex-wrap:wrap}\n.field{display:flex;flex-direction:column;gap:6px}\n.field>label,.field>.lab,.lab{font-weight:700}\n.field .hint{color:var(--ink2);font-size:.9rem}\n.in{min-height:52px;border:2px solid var(--line);border-radius:12px;padding:8px 14px;background:var(--surface);width:100%}\n.in.km{font-size:1.5rem;font-weight:700;font-variant-numeric:tabular-nums;text-align:right}\n.two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}\n@media (max-width:480px){.two{grid-template-columns:minmax(0,1fr)}}\n.dist{background:var(--surface2);border-radius:12px;padding:12px 16px;font-weight:700;font-size:1.1rem}\n.err{background:var(--over-bg);color:var(--over);border-radius:12px;padding:12px 16px;font-weight:700}\n.check{display:flex;gap:12px;align-items:flex-start;padding:14px;border:2px solid var(--line);border-radius:12px;cursor:pointer}\n.check input{width:26px;height:26px;flex:none;margin-top:2px;accent-color:var(--navy)}\n.check:has(input:checked){border-color:var(--ok);background:var(--ok-bg)}\n.stepper{display:flex;gap:8px;align-items:center}\n.stepper button{width:52px;height:52px;border-radius:12px;border:2px solid var(--line);background:var(--surface);font-size:1.5rem;font-weight:700;cursor:pointer}\n.stepper input{width:90px;text-align:center}\n.toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(96px + env(safe-area-inset-bottom,0px));background:var(--ink);color:var(--surface);padding:12px 22px;border-radius:999px;font-weight:700;z-index:50;max-width:calc(100vw - 32px)}\n.setgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,330px),1fr));gap:18px;align-items:start}\n.list{display:flex;flex-direction:column;gap:10px}\n.item{display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center;padding:12px 14px;border:1px solid var(--line);border-radius:12px}\n\n/* 노랑이 (노란 차 캐릭터) */\n.buddy{display:flex;gap:12px;align-items:center}\n.buddy svg{flex:none;width:84px;height:66px}\n.bubble{position:relative;flex:1;min-width:0;background:var(--surface2);border-radius:16px;padding:12px 16px}\n.bubble::before{content:\"\";position:absolute;left:-9px;top:50%;margin-top:-9px;border:9px solid transparent;border-right-color:var(--surface2);border-left:0}\n.bubble b{display:block;font-size:1.2rem;line-height:1.35}\n.bubble.over{background:var(--over-bg)} .bubble.over::before{border-right-color:var(--over-bg)}\n.bubble.soon{background:var(--soon-bg)} .bubble.soon::before{border-right-color:var(--soon-bg)}\n.bubble.ok{background:var(--ok-bg)} .bubble.ok::before{border-right-color:var(--ok-bg)}\n@media (max-width:480px){.buddy svg{width:64px;height:50px} .bubble b{font-size:1.08rem}}\n.season{display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center;border-top:1px solid var(--line);padding-top:12px}\n.tips{margin:0;padding-left:1.2em;display:flex;flex-direction:column;gap:8px}\n.checks{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px}\n.checks label{display:flex;gap:8px;align-items:center;padding:10px 12px;border:2px solid var(--line);border-radius:12px;cursor:pointer;font-weight:500}\n.checks input{width:22px;height:22px;flex:none;accent-color:var(--navy)}\n.checks label:has(input:checked){border-color:var(--ok);background:var(--ok-bg)}\n/* 점검 한눈에 (오늘 화면) */\n.board{display:flex;flex-direction:column;gap:14px}\n.verdict{display:flex;gap:14px;align-items:center}\n.light{width:54px;height:54px;border-radius:50%;flex:none;display:grid;place-items:center;font-family:var(--f-display);font-size:1.7rem;color:var(--surface)}\n.light.over{background:var(--over)} .light.soon{background:var(--soon)} .light.ok{background:var(--ok)} .light.unk{background:var(--unk)}\n.verdict b{font-size:1.25rem;display:block;line-height:1.3}\n.tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(168px,1fr));gap:10px}\n@media (max-width:480px){.tiles{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}}\n.tile{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:12px;border:2px solid var(--line);background:var(--surface);cursor:pointer;text-align:left;min-width:0;min-height:68px}\n.tile:hover{border-color:var(--ink2)}\n.tile .tx{min-width:0;display:flex;flex-direction:column;line-height:1.3}\n.tile .tx b{font-size:.98rem;overflow-wrap:anywhere}\n.tile .tx span{font-size:.86rem;font-variant-numeric:tabular-nums}\n.tile.over{background:var(--over-bg);border-color:var(--over)} .tile.over .tx span{color:var(--over);font-weight:700}\n.tile.soon{background:var(--soon-bg);border-color:var(--soon)} .tile.soon .tx span{color:var(--soon);font-weight:700}\n.tile.ok .tx span{color:var(--ink2)}\n.tile.unk{border-style:dashed} .tile.unk .tx span{color:var(--unk)}\n.ring{flex:none;width:40px;height:40px}\n.ring circle{fill:none;stroke-width:5}\n.ring .bg{stroke:var(--surface2)} .tile.over .ring .bg,.tile.soon .ring .bg{stroke:var(--surface)}\n.ring .fg{stroke-linecap:round;transform:rotate(-90deg);transform-origin:50% 50%}\n.ring.over .fg{stroke:var(--over)} .ring.soon .fg{stroke:var(--soon)} .ring.ok .fg{stroke:var(--ok)}\n.ring text{font-family:var(--f-body);font-weight:700;font-size:15px;fill:var(--ink2);text-anchor:middle}\n.ring.over text{fill:var(--over)} .ring.soon text{fill:var(--soon)}\n.legend{display:flex;flex-wrap:wrap;gap:6px 16px;color:var(--ink2);font-size:.86rem}\n.legend i{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:5px}\n.sub{display:flex;flex-wrap:wrap;gap:8px;align-items:center;border-top:1px solid var(--line);padding-top:12px}\n.warn{color:var(--soon);font-weight:700;font-size:.85rem}\n.bulk{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr) minmax(0,1fr);gap:8px;align-items:center}\n.bulk .in{min-height:46px;padding:6px 10px}\n@media (max-width:480px){.bulk{grid-template-columns:repeat(2,minmax(0,1fr))} .bulk b{grid-column:1/-1}}\nselect.in{appearance:auto}\n#printArea{display:none}\n@media print{\n  body{background:#fff;color:#000;padding:0;font-size:11pt}\n  .wrap,.toast,dialog{display:none!important}\n  #printArea{display:block}\n}\n@media (prefers-reduced-motion: no-preference){ .btn,.chip{transition:border-color .15s,background .15s} }\n</style>\n\n<div class=\"wrap\" id=\"app\">\n  <div class=\"top\">\n    <div class=\"brand\">\n      <svg width=\"46\" height=\"34\" viewBox=\"0 0 46 34\" aria-hidden=\"true\"><rect x=\"1\" y=\"5\" width=\"42\" height=\"21\" rx=\"5\" fill=\"#ffc400\"/><rect x=\"5\" y=\"9\" width=\"9\" height=\"8\" rx=\"1.5\" fill=\"#16233a\"/><rect x=\"16\" y=\"9\" width=\"9\" height=\"8\" rx=\"1.5\" fill=\"#16233a\"/><rect x=\"27\" y=\"9\" width=\"12\" height=\"8\" rx=\"1.5\" fill=\"#16233a\"/><rect x=\"1\" y=\"19\" width=\"42\" height=\"3\" fill=\"#16233a\"/><circle cx=\"12\" cy=\"27\" r=\"5\" fill=\"#16233a\"/><circle cx=\"12\" cy=\"27\" r=\"2\" fill=\"#cfd6e0\"/><circle cx=\"33\" cy=\"27\" r=\"5\" fill=\"#16233a\"/><circle cx=\"33\" cy=\"27\" r=\"2\" fill=\"#cfd6e0\"/></svg>\n      <div><b>차량 지킴이</b><br><span id=\"centerName\">지역아동센터 차량 점검 알림 · 운행일지</span></div>\n    </div>\n    <div class=\"topr\"><button class=\"btn sm fb\" id=\"fbBtn\" data-act=\"fb\" hidden>의견 보내기</button><div class=\"sync\" id=\"sync\" role=\"status\"><i></i><span>불러오는 중…</span></div></div>\n  </div>\n  <div class=\"tabs\" role=\"tablist\" id=\"tabs\"></div>\n  <div id=\"view\" role=\"tabpanel\"></div>\n</div>\n<dialog id=\"dlg\"></dialog>\n<input type=\"file\" id=\"restoreFile\" accept=\".json,application/json\" hidden>\n<div id=\"printArea\"></div>\n\n<script>\n'use strict';\n/* ============ 1. 규칙 (AI 없이 계산) — 이 파일이 계산식의 유일한 원본이다 ============ */\n// 점검 항목과 기본 주기. 일반 권장값이며 차량 취급설명서가 우선한다. 설정에서 차량별로 고칠 수 있다.\n// ev:false 인 항목은 전기차에서 숨긴다.\nvar ITEMS=[\n {k:'oil',   n:'엔진오일', full:'엔진오일·오일필터', km:10000, mo:12, skm:5000, smo:6, ev:false, tip:'엔진 속 부품이 닳지 않게 해 주는 기름'},\n {k:'airf',  n:'공기 필터', full:'에어클리너(공기 필터)', km:20000, mo:24, skm:10000, smo:12, ev:false, tip:'엔진으로 들어가는 공기의 먼지를 거름'},\n {k:'cabin', n:'에어컨 필터', full:'에어컨 필터', km:15000, mo:12, tip:'차 안으로 들어오는 공기를 거름. 아이들 호흡기와 관련'},\n {k:'rot',   n:'타이어 위치', full:'타이어 위치 교환', km:10000, mo:0, tip:'앞뒤 타이어 자리를 바꿔 고르게 닳게 함'},\n {k:'tire',  n:'타이어 교체', full:'타이어 교체', km:50000, mo:60, tip:'홈 깊이 1.6mm 아래면 바로 교체'},\n {k:'pad',   n:'브레이크 패드', full:'브레이크 패드', km:40000, mo:0, tip:'차를 세우는 부품. 끽 소리가 나면 바로 점검'},\n {k:'bfluid',n:'브레이크액', full:'브레이크액', km:40000, mo:24, tip:'브레이크 힘을 전달하는 액체'},\n {k:'cool',  n:'냉각수', full:'냉각수(부동액)', km:40000, mo:24, tip:'엔진이나 배터리가 과열되지 않게 식혀 줌'},\n {k:'batt',  n:'배터리', full:'배터리(시동용)', km:60000, mo:36, tip:'시동을 거는 전기. 겨울 전에 점검'},\n {k:'atf',   n:'변속기 오일', full:'변속기 오일', km:100000, mo:0, ev:false, tip:'변속기를 부드럽게 해 주는 기름'},\n {k:'wiper', n:'와이퍼', full:'와이퍼', km:0, mo:12, tip:'줄이 생기거나 소리가 나면 교체'}\n];\nvar FUELS=['경유','휘발유','LPG','전기'];\nvar PURPOSES=['등원','하원','체험활동','병원 동행','업무','기타'];\nvar SOON_DAYS=30;\n// 운행일지의 차량점검내용. pre:true는 운행 전, false는 운행 후에 보는 것.\nvar CHECKS=[{k:'tire',n:'타이어',pre:true},{k:'lamp',n:'전조등·방향지시등',pre:true},{k:'belt',n:'안전띠',pre:true},{k:'door',n:'차 문',pre:true},{k:'sleep',n:'하차확인장치',pre:true},{k:'off',n:'운행 후 하차 확인',pre:false}];\n// 예전 기록(운행 전 점검/하차 확인 두 칸)도 같은 모양으로 읽는다\nfunction checksOf(t){\n  if(t.checks) return t.checks;\n  var out=[]; CHECKS.forEach(function(c){ if(c.pre?t.pre:t.post) out.push(c.k); }); return out;\n}\nfunction checkText(t){\n  var have=checksOf(t), miss=CHECKS.filter(function(c){return have.indexOf(c.k)<0;}).map(function(c){return c.n;});\n  var s=miss.length===0?'이상 없음 ('+CHECKS.length+'항목 점검)':have.length===0?'점검 안 함':'점검 '+have.length+'/'+CHECKS.length+' · 안 본 것: '+miss.join(', ');\n  return s+(t.checkNote?' · '+t.checkNote:'');\n}\n// 철마다 챙길 것. 일반적인 관리 요령이며 차량 설명서와 정비소 안내가 우선한다.\nvar SEASONS=[\n {m:[12,1,2],name:'겨울철',line:'추운 아침에는 시동이 잘 안 걸릴 수 있어요. 배터리와 부동액을 봐 주세요.',items:['배터리: 3년이 넘었으면 정비소에서 상태를 재 보세요','부동액(냉각수): 양이 눈금 사이에 있는지 보세요','타이어: 공기압이 낮아지기 쉬워요. 홈이 얕으면 눈길에 미끄러져요','워셔액: 겨울용(얼지 않는 것)으로 채워 주세요','앞 유리 성에: 출발 5분 전에 히터를 틀어 시야를 확보하세요','눈·얼음이 있는 날은 평소보다 일찍 출발하고 천천히 다녀요']},\n {m:[3,4,5],name:'봄철',line:'황사와 꽃가루가 많은 때예요. 에어컨 필터를 봐 주세요.',items:['에어컨 필터: 아이들 호흡기를 위해 봄에 한 번 갈아 주세요','세차: 겨울에 묻은 제설제(염화칼슘)를 차 아래까지 씻어 내세요','와이퍼: 겨울을 지나며 고무가 굳었는지 보세요','타이어: 공기압을 다시 맞춰 주세요']},\n {m:[6,7],name:'장마철',line:'비가 많이 오는 때예요. 와이퍼와 타이어 홈을 봐 주세요.',items:['와이퍼: 줄이 생기거나 소리가 나면 갈아 주세요','타이어: 홈이 얕으면 빗길에 미끄러져요 (1.6mm 아래면 교체)','전조등·브레이크등: 비 오는 날은 낮에도 켜요. 불이 다 들어오는지 보세요','앞 유리 김 서림: 에어컨을 앞 유리 쪽으로 틀어요','물이 고인 길은 돌아가고, 빗길에서는 속도를 줄여요','에어컨 필터: 눅눅한 냄새가 나면 갈아 주세요']},\n {m:[8],name:'한여름',line:'더위에 엔진이 뜨거워지기 쉬워요. 냉각수와 에어컨을 봐 주세요.',items:['냉각수: 양이 눈금 사이에 있는지 보세요. 계기판 온도 바늘이 올라가면 바로 세워요','에어컨: 바람이 시원하지 않으면 정비소에 가요','타이어: 뜨거운 길에서는 공기압이 중요해요','차 안에 아이가 남지 않았는지 꼭 확인해요. 여름 차 안은 금방 뜨거워져요']},\n {m:[9,10,11],name:'가을철',line:'겨울이 오기 전에 미리 챙겨 두면 편해요. 배터리와 히터를 봐 주세요.',items:['배터리: 추워지기 전에 정비소에서 상태를 재 보세요','히터: 따뜻한 바람이 잘 나오는지 틀어 보세요','부동액(냉각수): 2년이 넘었으면 정비소에 물어보세요','타이어: 홈 깊이와 공기압을 봐 주세요','해가 일찍 져요. 전조등이 다 들어오는지 보세요']}\n];\nfunction seasonOf(dateStr){var m=+String(dateStr).split('-')[1]; for(var i=0;i<SEASONS.length;i++) if(SEASONS[i].m.indexOf(m)>=0) return SEASONS[i]; return SEASONS[0];}\n// 노란 차 캐릭터 '노랑이'가 하는 말\nfunction mascotSay(al){\n  var over=al.filter(function(a){return a.st==='over';}), soon=al.filter(function(a){return a.st==='soon';}), ok=al.filter(function(a){return a.st==='ok';});\n  function names(x){return x.slice(0,2).map(function(a){return a.name;}).join(', ')+(x.length>2?' 등':'');}\n  if(over.length) return {mood:'over',head:'점검할 시기가 지났어요. 신경 써 주세요!',sub:names(over)+(over.length>1?'을(를) 먼저':'부터')+' 챙겨 주세요.'+(soon.length?' 곧 챙길 것도 '+soon.length+'가지 있어요.':'')};\n  if(soon.length) return {mood:'soon',head:'점검할 시기예요. 신경 써 주세요!',sub:names(soon)+' 차례가 다가오고 있어요.'};\n  if(ok.length) return {mood:'ok',head:'지금은 모두 괜찮아요. 고마워요!',sub:'운행하고 나서 기록만 남겨 주세요.'};\n  return {mood:'unk',head:'아직 제 정비 기록이 없어요.',sub:'마지막으로 교환한 날을 알려 주시면 다음 시기를 챙겨 드릴게요.'};\n}\nfunction soonKm(interval){return Math.min(2000,Math.max(500,Math.round(interval*0.1)));}\nfunction ymd(d){return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');}\nfunction today(){return ymd(new Date());}\nfunction parseD(s){var p=String(s).split('-');return new Date(+p[0],+p[1]-1,+p[2]);}\nfunction addMonths(s,m){var d=parseD(s),day=d.getDate();d.setDate(1);d.setMonth(d.getMonth()+m);var last=new Date(d.getFullYear(),d.getMonth()+1,0).getDate();d.setDate(Math.min(day,last));return ymd(d);}\nfunction addDays(s,n){var d=parseD(s);d.setDate(d.getDate()+n);return ymd(d);}\nfunction daysBetween(a,b){return Math.round((parseD(b)-parseD(a))/86400000);}\nfunction fmtKm(n){return String(Math.round(Number(n))).replace(/\\B(?=(\\d{3})+(?!\\d))/g,',');}\nfunction fmtD(s){if(!s)return '';var p=s.split('-');return p[0]+'.'+p[1]+'.'+p[2]+'.';}\nfunction fmtMD(s){var p=s.split('-');return (+p[1])+'월 '+(+p[2])+'일';}\nfunction vals(o){return Object.keys(o||{}).map(function(k){return o[k];});}\nfunction itemsFor(v){return ITEMS.filter(function(it){return !(v&&v.fuel==='전기'&&it.ev===false);});}\nfunction intervalOf(v,it){\n  var o=(v.intervals||{})[it.k];\n  if(o) return {km:+o.km||0, mo:+o.mo||0};\n  if(v.severe && it.skm) return {km:it.skm, mo:it.smo};\n  return {km:it.km, mo:it.mo};\n}\n// 현재 주행거리 = 등록한 계기판 숫자, 차량에 적어 둔 최신 km(odo), 운행일지 도착 km, 정비 기록 km 중 가장 큰 값\nfunction odoOf(S,vid){\n  var v=S.vehicles[vid]||{}, m=Math.max(+v.baseOdo||0,+v.odo||0);\n  vals(S.trips).forEach(function(t){if(t.vid===vid&&+t.endKm>m)m=+t.endKm;});\n  vals(S.services).forEach(function(s){if(s.vid===vid&&+s.km>m)m=+s.km;});\n  return m;\n}\n// 최근 30일 하루 평균 주행거리 (예상 날짜 계산용). 기록이 7일 치보다 적으면 0.\nfunction dailyKm(S,vid,now){\n  var from=addDays(now,-30), sum=0, first=null;\n  vals(S.trips).forEach(function(t){ if(t.vid===vid&&t.date>=from&&t.date<=now){sum+=(+t.endKm)-(+t.startKm); if(!first||t.date<first)first=t.date;} });\n  if(!first||daysBetween(first,now)<7) return 0;\n  return sum/Math.max(1,daysBetween(first,now)+1);\n}\nfunction lastService(S,vid,k){\n  var best=null;\n  vals(S.services).forEach(function(s){ if(s.vid===vid&&s.item===k&&(!best||s.date>best.date||(s.date===best.date&&(+s.km||0)>(+best.km||0)))) best=s; });\n  return best;\n}\n// 한 항목의 상태를 계산한다. 근거(why) 문장을 함께 만든다.\nfunction itemStatus(S,vid,it,now){\n  var v=S.vehicles[vid], iv=intervalOf(v,it), last=lastService(S,vid,it.k), odo=odoOf(S,vid);\n  var src=v.ivChecked?'차량 설명서로 확인한 주기':'일반 권장 주기';\n  if(!last) return {st:'unk', label:'기록 없음', why:'마지막으로 교환한 날을 아직 적지 않았어요. 정비소 스티커나 명세서를 보고 적어 주세요.', iv:iv, ratio:0, src:src};\n  var parts=[], st='ok', ratio=0, kmLeft=null, dLeft=null, dueD=null, estD=null;\n  if(iv.km>0 && +last.km>0){\n    var due=+last.km+iv.km; kmLeft=due-odo; ratio=Math.max(ratio,(odo-last.km)/iv.km);\n    parts.push('마지막 교환 '+fmtKm(last.km)+'km + 주기 '+fmtKm(iv.km)+'km = '+fmtKm(due)+'km, 지금 '+fmtKm(odo)+'km');\n    if(kmLeft<0) st='over'; else if(kmLeft<=soonKm(iv.km)) st='soon';\n    var dk=dailyKm(S,vid,now); if(dk>0&&kmLeft>=0) estD=addDays(now,Math.round(kmLeft/dk));\n  }\n  if(iv.mo>0){\n    dueD=addMonths(last.date,iv.mo); dLeft=daysBetween(now,dueD);\n    ratio=Math.max(ratio,daysBetween(last.date,now)/Math.max(1,daysBetween(last.date,dueD)));\n    parts.push('마지막 교환 '+fmtD(last.date)+' + '+iv.mo+'개월 = '+fmtD(dueD));\n    if(dLeft<0) st='over'; else if(dLeft<=SOON_DAYS && st!=='over') st='soon';\n  }\n  var label;\n  if(st==='over'){ label=(kmLeft!==null&&kmLeft<0)?fmtKm(-kmLeft)+'km 지남':(-dLeft)+'일 지남'; }\n  else { var a=[]; if(kmLeft!==null)a.push(fmtKm(kmLeft)+'km 남음'); if(dLeft!==null)a.push(dLeft+'일 남음'); label=a.join(' · ')||'기록됨'; }\n  if(iv.km>0 && !(+last.km>0)) parts.push('교환 때 km를 적지 않아 날짜로만 계산');\n  // 달력에 넣을 날짜: 날짜 기한과 km 예상일 중 빠른 쪽\n  var when=dueD; if(estD&&(!when||estD<when)) when=estD;\n  return {st:st,label:label,why:parts.join(' / '),iv:iv,ratio:ratio,last:last,kmLeft:kmLeft,dLeft:dLeft,estD:estD,when:when,src:src};\n}\n// 날짜로만 보는 항목 (정기검사, 보험, 안전교육)\nfunction dateStatus(due,now){\n  if(!due) return {st:'unk',label:'날짜 없음'};\n  var d=daysBetween(now,due);\n  return {st:d<0?'over':(d<=SOON_DAYS?'soon':'ok'), label:d<0?(-d)+'일 지남':d+'일 남음', dLeft:d};\n}\nfunction driversOf(S){\n  return Object.keys(S.drivers||{}).map(function(id){var d=S.drivers[id];return {id:id,name:d.name,edu:d.edu,ts:d.ts||0};}).sort(function(a,b){return a.ts-b.ts;});\n}\nfunction allAlerts(S,vid,now){\n  var out=[], v=S.vehicles[vid]; if(!v) return out;\n  itemsFor(v).forEach(function(it){var r=itemStatus(S,vid,it,now); out.push({kind:'item',key:it.k,name:it.n,full:it.full,tip:it.tip,st:r.st,label:r.label,why:r.why,ratio:r.ratio,estD:r.estD,when:r.when,src:r.src,iv:r.iv});});\n  var a=dateStatus(v.inspDate,now); out.push({kind:'insp',key:'insp',name:'정기검사',full:'자동차 정기검사',tip:'자동차등록증에 적힌 검사 유효기간',st:a.st,label:a.label,when:v.inspDate||null,ratio:a.st==='unk'?0:Math.min(1,1-a.dLeft/365),why:v.inspDate?'검사 유효기간 만료일 '+fmtD(v.inspDate)+' (자동차등록증에 적힌 날짜)':'자동차등록증의 검사 유효기간 만료일을 적어 주세요.'});\n  var b=dateStatus(v.insDate,now); out.push({kind:'ins',key:'ins',name:'보험 만기',full:'자동차 보험 만기',tip:'보험증권에 적힌 끝 날짜',st:b.st,label:b.label,when:v.insDate||null,ratio:b.st==='unk'?0:Math.min(1,1-b.dLeft/365),why:v.insDate?'보험 만기일 '+fmtD(v.insDate):'보험증권의 만기일을 적어 주세요.'});\n  driversOf(S).forEach(function(d){\n    var due=d.edu?addMonths(d.edu,24):''; var c=dateStatus(due,now);\n    out.push({kind:'edu',key:'edu:'+d.id,name:d.name+' 안전교육',full:d.name+' 선생님 통학버스 안전교육',tip:'2년마다 다시 받는 교육 (주기는 관할 안내로 확인)',st:c.st,label:c.label,when:due||null,ratio:c.st==='unk'?0:Math.min(1,1-c.dLeft/730),why:d.edu?'마지막 교육 '+fmtD(d.edu)+' + 2년 = '+fmtD(due):'마지막 교육 받은 날을 적어 주세요.'});\n  });\n  var rank={over:0,soon:1,unk:3,ok:2};\n  out.forEach(function(x,i){x.i=i;});\n  out.sort(function(x,y){return rank[x.st]-rank[y.st]||y.ratio-x.ratio||x.i-y.i;});\n  return out;\n}\n// 한 차량의 운행을 날짜·km 순으로 놓고, 앞 기록의 도착 km와 출발 km가 다른 기록을 찾는다.\nfunction gaps(S,vid){\n  var list=Object.keys(S.trips).filter(function(id){return S.trips[id].vid===vid;}).map(function(id){return {id:id,t:S.trips[id]};});\n  list.sort(function(a,b){return a.t.date<b.t.date?-1:a.t.date>b.t.date?1:(+a.t.startKm)-(+b.t.startKm);});\n  var out={};\n  for(var i=1;i<list.length;i++){ var d=(+list[i].t.startKm)-(+list[i-1].t.endKm); if(d!==0) out[list[i].id]=d; }\n  return out;\n}\nfunction isLocked(S,month){return ((S.settings||{}).locks||[]).indexOf(month)>=0;}\n\n/* 한글(HWPX) 파일의 바탕. python-hwpx의 빈 문서에 운행일지용 글자·문단·테두리 모양을 더해 만든 것이다 (자동 생성, 고치지 않는다). */\nvar HWPX_IDS={\"cTitle\": \"7\", \"cBold\": \"8\", \"cNorm\": \"9\", \"cInfo\": \"10\", \"pCenter\": \"20\", \"pLeft\": \"21\", \"pRight\": \"22\", \"bLine\": \"3