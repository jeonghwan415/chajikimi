ground:var(--over-bg)} .bubble.over::before{border-right-color:var(--over-bg)}\n.bubble.soon{background:var(--soon-bg)} .bubble.soon::before{border-right-color:var(--soon-bg)}\n.bubble.ok{background:var(--ok-bg)} .bubble.ok::before{border-right-color:var(--ok-bg)}\n@media (max-width:480px){.buddy svg{width:64px;height:50px} .bubble b{font-size:1.08rem}}\n.season{display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center;border-top:1px solid var(--line);padding-top:12px}\n.tips{margin:0;padding-left:1.2em;display:flex;flex-direction:column;gap:8px}\n.checks{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px}\n.checks label{display:flex;gap:8px;align-items:center;padding:10px 12px;border:2px solid var(--line);border-radius:12px;cursor:pointer;font-weight:500}\n.checks input{width:22px;height:22px;flex:none;accent-color:var(--navy)}\n.checks label:has(input:checked){border-color:var(--ok);background:var(--ok-bg)}\n/* 점검 한눈에 (오늘 화면) */\n.board{display:flex;flex-direction:column;gap:14px}\n.verdict{display:flex;gap:14px;align-items:center}\n.light{width:54px;height:54px;border-radius:50%;flex:none;display:grid;place-items:center;font-family:var(--f-display);font-size:1.7rem;color:var(--surface)}\n.light.over{background:var(--over)} .light.soon{background:var(--soon)} .light.ok{background:var(--ok)} .light.unk{background:var(--unk)}\n.verdict b{font-size:1.25rem;display:block;line-height:1.3}\n.tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(168px,1fr));gap:10px}\n@media (max-width:480px){.tiles{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}}\n.tile{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:12px;border:2px solid var(--line);background:var(--surface);cursor:pointer;text-align:left;min-width:0;min-height:68px}\n.tile:hover{border-color:var(--ink2)}\n.tile .tx{min-width:0;display:flex;flex-direction:column;line-height:1.3}\n.tile .tx b{font-size:.98rem;overflow-wrap:anywhere}\n.tile .tx span