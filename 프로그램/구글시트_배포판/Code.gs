ld[open]>summary .open .c{display:none} .fold:not([open])>summary .open .o{display:none}\n.fold[open]>summary{border-bottom:1px solid var(--line)}\n.fold>.board{border:0;border-radius:0}\n/* v4: 자주 하는 운행 바로 적기 */\n.quick{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px}\n.quick .btn{flex-direction:column;align-items:flex-start;text-align:left;gap:2px;min-height:64px}\n.quick .btn small{font-weight:500;color:var(--ink2);font-size:.86rem}\n/* v4: 표에 바로 적기 (종이 일지처럼 한 줄씩) */\n.entryhelp{display:flex;flex-wrap:wrap;gap:8px 14px;align-items:center}\n.credit{text-align:center;color:var(--ink2);font-size:.85rem;padding:18px 0 8px;border-top:1px solid var(--line)}\n/* 시간 고르기: [오전][오후] → 시 → 분(5분 단위). 다음에 고를 칸은 노란 테두리 + 깜박이는 커서 */\n.tsel{display:flex;flex-direction:column;gap:8px;padding:10px;border:2px solid var(--line);border-radius:14px;background:var(--surface)}\n.tsel.done{border-color:var(--ok)}\n.ampm{display:grid;grid-template-columns:1fr 1fr;gap:6px;border-radius:12px}\n.ampm button{min-height:50px;border:2px solid var(--line);border-radius:12px;background:var(--surface);font-size:1.1rem;font-weight:700;cursor:pointer;color:var(--ink2)}\n.ampm button[aria-pressed=\"true\"]{background:var(--navy);border-color:var(--navy);color:var(--navy-ink)}\n.hm{display:flex;align-items:center;gap:6px}\n.hm .slot{flex:1;min-width:0;position:relative;display:block;border-radius:12px}\n.hm select{width:100%;min-height:52px;font-size:1.15rem;font-weight:700;font-variant-numeric:tabular-nums}\n.hm .colon{font-size:1.4rem;color:var(--ink2)}\n.tsel .next{box-shadow:0 0 0 3px var(--bus)}\n.hm .slot.next select{padding-left:30px;border-color:var(--bus)}\n.hm .slot.next::before{content:\"\";position:absolute;left:14px;top:50%;width:2px;height:24px;margin-top:-12px;background:var(--ink);pointer-events:none;z-index:1}\n.thint{font-size:.92rem;color:var(--soon);font-weight:700;min-height:1.4em}\n.tsel.done .thint{color:var(--ok);font-weight:500}\n@media (prefers-reduced-motion: no-preference){\n  .hm .slot.next::before{animation:caret 1.05s steps(1) infinite}\n  .ampm.next{animation:ring 1.6s ease-in-out infinite}\n}\n@keyframes caret{50%{opacity:0}}\n@keyframes ring{50%{box-shadow:0 0 0 6px var(--bus)}}\n/* 운행일지 표: PC 화면 폭 안에 들어오게 긴 칸은 줄바꿈 */\n.logt th,.logt td{padding:10px 8px}\n.logt td{white-space:normal} .logt td.r{white-space:nowrap}\n.logt td.chk{min-width:150px;font-size:.92rem} .logt .linkbtn{white-space:nowrap}\n.logt th{white-space:normal}\n/* 표 아래 노란 칸 (표에 바로 적기) */\n.entry{background:var(--soon-bg);border-color:var(--bus);display:flex;flex-direction:column;gap:12px}\n.ehead{display:flex;flex-wrap:wrap;gap:4px 12px;align-items:baseline}\n.egrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px 12px;align-items:start}\n.ef{display:flex;flex-direction:column;gap:6px;min-width:0}\n.ef.wide{grid-column:span 2} @media (max-width:480px){.ef.wide{grid-column:auto}}\n.eflab{font-weight:700;font-size:.92rem}\n.ef .in{min-height:46px;padding:6px 10px}\n.ef .num{text-align:right;font-variant-numeric:tabular-nums}\n.ef .ck{display:flex;gap:6px;align-items:center;font-size:.92rem;font-weight:500}\n.ef .ck input{width:22px;height:22px;accent-color:var(--navy)}\n.ef .tsel{padding:6px;gap:6px}\n.ef .ampm button{min-height:42px}\n.ef .hm select{min-height:44px}\n.ef .thint{font-size:.85rem}\n/* 꼭 적을 칸 표시, 아직 비어 있는 도착 km */\n.need{display:inline-block;background:var(--bus);color:var(--bus-ink);border-radius:6px;font-size:.75rem;font-weight:700;padding:0 6px;margin-left:6px;vertical-align:2px}\n#tEnd:placeholder-shown{border-color:var(--bus);box-shadow:0 0 0 3px rgba(255,196,0,.35)}\n/* 인쇄·파일 메뉴 */\n.menu{position:relative}\n.menu>summary{list-style:none}\n.menu>summary::-webkit-details-marker{display:none}\n.menu-list{position:absolute;right:0;top:calc(100% + 6px);z-index:30;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:8px;display:flex;flex-direction:column;gap:6p